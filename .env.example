# ==============================================================================
# JIRA HELPDESK REPORT - ARCHIVO DE CONFIGURACIÓN (.env.example)
# Copia este archivo como '.env' en tu servidor y reemplaza los valores reales.
# ==============================================================================

# Nombre de la aplicación y zona horaria
APP_NAME="Jira Helpdesk Report"
APP_TIMEZONE="America/Santiago"

# Base de datos (PostgreSQL para Docker o SQLite para local)
# En Docker Compose: postgresql+psycopg://jira:jira@db:5432/jira_report
# En Local: sqlite:///./jira_report.db
DATABASE_URL=postgresql+psycopg://jira:jira@db:5432/jira_report

# ------------------------------------------------------------------------------
# SEGURIDAD Y AUTENTICACIÓN
# ------------------------------------------------------------------------------
# Genera una clave secreta segura (ej: openssl rand -hex 32)
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_produccion_64_caracteres
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TuPasswordSeguro2026!
SESSION_COOKIE_NAME=jira_session_token
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# INTEGRACIÓN JIRA CLOUD
# ------------------------------------------------------------------------------
JIRA_BASE_URL=https://tu-dominio.atlassian.net
JIRA_EMAIL=tu-correo@empresa.cl
JIRA_API_TOKEN=tu_jira_api_token_aqui
JIRA_JQL="project = HD ORDER BY updated DESC"
JIRA_PROJECT_KEY=MABC

# Custom Fields Jira
JIRA_ORGANIZATION_FIELD_ID=customfield_10002
JIRA_CLIENT_FIELD_ID=customfield_10495
JIRA_SERVICE_LEVEL_FIELD_ID=customfield_10528
JIRA_TIPO_ATENCION_FIELD_ID=customfield_10561
JIRA_CATEGORIA_TICKET_FIELD_ID=customfield_10396
JIRA_FECHA_INICIO_FIELD_ID=customfield_10015

# Parámetros de Sincronización
WEEKLY_HOURS=40
DAILY_HOURS=8
SYNC_PAGE_SIZE=50
SYNC_MAX_ISSUES=5000
SYNC_INTERVAL_HOURS=2

# ------------------------------------------------------------------------------
# NOTIFICACIONES TELEGRAM (OPCIONAL)
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# NOTIFICACIONES CORREO SMTP (OPCIONAL)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@empresa.cl
SMTP_PASSWORD=tu_password_de_aplicacion
EMAIL_FROM=notificaciones@empresa.cl
EMAIL_TO=admin@empresa.cl
